{
  "name": "simimd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-based Markdown editor for GitHub Pages and Cloudflare.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "dev:pages": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name simimd --branch main",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@viz-js/viz": "3.31.0",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "jsdom": "26.1.0",
    "json5": "2.2.3",
    "markdown-it": "14.3.3",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-container": "4.0.0",
    "markdown-it-deflist": "3.0.0",
    "markdown-it-emoji": "3.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "pako": "2.1.0",
    "wrangler": "4.157.0"
  }
}
